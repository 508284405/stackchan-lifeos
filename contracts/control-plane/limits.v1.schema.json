{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackchan.local/schemas/control-plane/v1/limits.json",
  "title": "StackChan LifeOS Control Plane Limits v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "wire", "session", "traffic", "autonomy"],
  "properties": {
    "schema": {"const": "lifeos.control-plane.limits.v1"},
    "contract_version": {"const": "1.0.0"},
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_message_bytes", "max_payload_bytes", "max_message_age_ms"],
      "properties": {
        "max_message_bytes": {"const": 16384},
        "max_payload_bytes": {"const": 8192},
        "max_message_age_ms": {"const": 120000}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heartbeat_interval_ms", "heartbeat_timeout_ms", "max_clock_skew_ms", "replay_retention_ms"],
      "properties": {
        "heartbeat_interval_ms": {"const": 15000},
        "heartbeat_timeout_ms": {"const": 45000},
        "max_clock_skew_ms": {"const": 30000},
        "replay_retention_ms": {"const": 86400000}
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steady_bytes_per_edge_per_minute", "burst_bytes_per_edge", "telemetry_bytes_per_edge_per_minute", "control_bytes_per_edge_per_minute", "ota_bytes_per_rollout"],
      "properties": {
        "steady_bytes_per_edge_per_minute": {"const": 262144},
        "burst_bytes_per_edge": {"const": 65536},
        "telemetry_bytes_per_edge_per_minute": {"const": 131072},
        "control_bytes_per_edge_per_minute": {"const": 65536},
        "ota_bytes_per_rollout": {"const": 0}
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_control_disconnect", "allow_local_safety", "allow_local_behaviors", "queue_remote_motion", "queue_ota"],
      "properties": {
        "on_control_disconnect": {"const": "reject_new_remote_commands"},
        "allow_local_safety": {"const": true},
        "allow_local_behaviors": {"const": true},
        "queue_remote_motion": {"const": false},
        "queue_ota": {"const": false}
      }
    }
  }
}
