# The default development path uses DeterministicCognitionProvider and needs no token.
STACKCHAN_COGNITION_PROVIDER=fake
STACKCHAN_CODEX_COMMAND=codex app-server --stdio
STACKCHAN_CODEX_TIMEOUT_SECONDS=8
STACKCHAN_DATABASE_URL=sqlite:///brain/data/lifeos.db
STACKCHAN_DEVICE_URL=ws://stackchan.local/ws

